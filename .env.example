# Required on every start. Generate once (for example with
# `openssl rand -base64 32`) and keep the same value with the persisted DB.
CODEX_QUEUE_MASTER_KEY=replace-with-base64-encoded-32-byte-key

# Optional image and logging settings.
# CODEX_QUEUE_BOT_IMAGE=ghcr.io/alliottech/codex-queue-bot:latest
# LOG_LEVEL=info

# Optional outbound proxy. It remains externally managed rather than stored in
# the UI/database. Changes require a service restart. HTTP(S), SOCKS5/SOCKS5H,
# ALL_PROXY, lower-case variants, and NO_PROXY are supported consistently.
# HTTP_PROXY=socks5://host.docker.internal:1080
# NO_PROXY=localhost,127.0.0.1
