# Required on every start. Generate once (for example with
# `openssl rand -base64 32`) and keep the same value with the persisted DB.
CODEX_QUEUE_MASTER_KEY=replace-with-base64-encoded-32-byte-key

# Optional image and logging settings.
# CODEX_QUEUE_BOT_IMAGE=ghcr.io/alliottech/codex-queue-bot:latest
# LOG_LEVEL=info

# The variables below are read only while importing a legacy config.json that
# refers to api_key_env/token_env. After import, the encrypted values live in
# SQLite and these variables can be removed.
# OPENILINK_APP_TOKEN=replace-with-openilink-app-token
# TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
# CODEX_KEY_PRIMARY=replace-with-primary-key
# CODEX_KEY_BACKUP=replace-with-backup-key

# Optional outbound proxy. It remains externally managed rather than stored in
# the UI/database.
# HTTP_PROXY=socks5://host.docker.internal:1080
# NO_PROXY=localhost,127.0.0.1
