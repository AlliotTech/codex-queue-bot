{
  "openilink": {
    "enabled": false,
    "base_url": "https://hub.example.com",
    "token_env": "OPENILINK_APP_TOKEN",
    "allowed_user_ids": [
      "wxid_your_user_id"
    ],
    "http_timeout_seconds": 15
  },
  "web": {
    "listen_address": ":8080",
    "admin_username": "admin",
    "admin_password_env": "WEB_ADMIN_PASSWORD",
    "cookie_secure": true,
    "trusted_proxies": [],
    "activity_limit": 200
  },
  "codex": {
    "binary": "codex",
    "prompts_file": "prompts.txt",
    "request_timeout_seconds": 180,
    "retry_min_seconds": 3,
    "retry_max_seconds": 8,
    "keepalive_min_seconds": 2700,
    "keepalive_max_seconds": 3300,
    "max_parallel": 2,
    "success_message": "开蹬",
    "reasoning_effort": "low",
    "config_overrides": [],
    "targets": [
      {
        "name": "primary",
        "api_base_url": "https://codex-a.example.com/v1",
        "api_key_env": "CODEX_KEY_PRIMARY",
        "model": "gpt-5.2-codex",
        "wire_api": "responses"
      },
      {
        "name": "backup",
        "api_base_url": "https://codex-b.example.com/v1",
        "api_key_env": "CODEX_KEY_BACKUP",
        "model": "gpt-5.2-codex",
        "wire_api": "responses"
      }
    ]
  }
}
